---
import Layout from "../layouts/Layout.astro";
import TestimonialsSection from "../components/TestimonialsSection";
import FormularioSelector from "../components/FormularioSelector";
import PortfolioStats from "../components/PortfolioStats";
const faqData = [
  {
    question: "¿Cómo se verifican los testimonios?",
    answer:
      "Todos los testimonios son revisados manualmente antes de ser publicados para asegurar su autenticidad y calidad.",
  },
  {
    question: "¿Puedo editar mi testimonio?",
    answer:
      "Una vez enviado, el testimonio pasa por un proceso de revisión. Si necesitas hacer cambios, puedes contactarme directamente.",
  },
  {
    question: "¿Qué información se muestra?",
    answer:
      "Solo se muestra tu nombre, empresa (si la proporcionas), cargo, calificación y comentario. Tu información personal está protegida.",
  },
  {
    question: "¿Cuánto tiempo tarda?",
    answer:
      "Los testimonios son revisados dentro de las 24-48 horas posteriores al envío.",
  },
];
---

<Layout
  title="Testimonios y Reseñas de Clientes | Peko's Web Chile"
  description="Opiniones y experiencias reales de empresas y clientes que han confiado en Peko's para el diseño de sus sitios web, tiendas online y plataformas digitales en Chile."
  faqData={faqData}
>
  <main class="min-h-screen bg-primary relative">
    <!-- Fondo futurístico -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-primary"></div>
    </div>

    <!-- Contenedor principal centrado -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-8">
      <!-- Hero Section Futurístico -->
      <section class="text-center mb-16">
        <div class="relative">
          <!-- Efecto de escaneo -->
          <div class="absolute inset-0 scan-line"></div>

          <div
            class="bg-slate-900/60 rounded-3xl border border-slate-700/60 p-8 sm:p-12 shadow-2xl"
          >
            <h1
              class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-white tracking-tight break-words"
            >
              TESTIMONIOS
            </h1>
            <div
              class="w-24 sm:w-32 h-1 bg-blue-500 mx-auto mb-8 rounded-full"
            >
            </div>
            <p
              class="text-lg sm:text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed px-2"
            >
              Descubre lo que mis clientes dicen sobre mi trabajo y comparte tu
              propia experiencia
            </p>

            <!-- Estadísticas flotantes -->
            <PortfolioStats client:load />
          </div>
        </div>
      </section>

      <!-- Testimonials Section -->
      <section class="mb-16">
        <div
          class="py-2 sm:py-4"
        >
          <TestimonialsSection client:load />
        </div>
      </section>

      <!-- Add Testimonial Section -->
      <section class="mb-16">
        <div
          class="py-2 sm:py-4"
        >
          <div class="text-center mb-12">
            <h2
              class="text-3xl sm:text-4xl font-bold text-white mb-4"
            >
              ¿Trabajamos juntos?
            </h2>
            <p class="text-xl text-gray-300">
              Comparte tu experiencia y ayuda a otros a conocerme mejor
            </p>
            <div
              class="w-24 h-0.5 bg-blue-500 mx-auto mt-6 rounded-full"
            >
            </div>
          </div>

          <div class="max-w-2xl mx-auto">
            <FormularioSelector client:load />
          </div>
        </div>
      </section>

      <!-- FAQ Section Futurístico -->
      <section class="mb-16">
        <div
          class="py-2 sm:py-4"
        >
          <div class="text-center mb-12">
            <h2
              class="text-3xl sm:text-4xl font-bold text-white mb-4"
            >
              Preguntas Frecuentes
            </h2>
            <p class="text-xl text-gray-300">
              Todo lo que necesitas saber sobre los testimonios
            </p>
            <div
              class="w-24 h-0.5 bg-blue-500 mx-auto mt-6 rounded-full"
            >
            </div>
          </div>

          <div class="max-w-4xl mx-auto grid gap-6 md:grid-cols-2">
            <div
              class="bg-slate-900/50 rounded-2xl border border-slate-700/60 p-6 hover:border-slate-500 transition-colors duration-200"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="flex-shrink-0 w-12 h-12 bg-slate-700 rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-3">
                    ¿Cómo se verifican los testimonios?
                  </h3>
                  <p class="text-gray-300 leading-relaxed">
                    Todos los testimonios son revisados manualmente antes de ser
                    publicados para asegurar su autenticidad y calidad.
                  </p>
                </div>
              </div>
            </div>

            <div
              class="bg-slate-900/50 rounded-2xl border border-slate-700/60 p-6 hover:border-slate-500 transition-colors duration-200"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="flex-shrink-0 w-12 h-12 bg-slate-700 rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-3">
                    ¿Puedo editar mi testimonio?
                  </h3>
                  <p class="text-gray-300 leading-relaxed">
                    Una vez enviado, el testimonio pasa por un proceso de
                    revisión. Si necesitas hacer cambios, puedes contactarme
                    directamente.
                  </p>
                </div>
              </div>
            </div>

            <div
              class="bg-slate-900/50 rounded-2xl border border-slate-700/60 p-6 hover:border-slate-500 transition-colors duration-200"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="flex-shrink-0 w-12 h-12 bg-slate-700 rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-3">
                    ¿Qué información se muestra?
                  </h3>
                  <p class="text-gray-300 leading-relaxed">
                    Solo se muestra tu nombre, empresa (si la proporcionas),
                    cargo, calificación y comentario. Tu información personal
                    está protegida.
                  </p>
                </div>
              </div>
            </div>

            <div
              class="bg-slate-900/50 rounded-2xl border border-slate-700/60 p-6 hover:border-slate-500 transition-colors duration-200"
            >
              <div class="flex items-start space-x-4">
                <div
                  class="flex-shrink-0 w-12 h-12 bg-slate-700 rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-3">
                    ¿Cuánto tiempo tarda?
                  </h3>
                  <p class="text-gray-300 leading-relaxed">
                    Los testimonios son revisados dentro de las 24-48 horas
                    posteriores al envío.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Botón de regreso -->
      <section class="text-center">
        <a
          href="/"
          class="inline-flex items-center px-8 py-4 bg-blue-600 text-white rounded-2xl hover:bg-blue-700 transition-colors duration-200 shadow-lg border border-blue-500/40"
        >
          <svg
            class="mr-2 w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Volver al Portfolio
        </a>
      </section>
    </div>
  </main>
</Layout>

<style>
  .glitch-bg {
    background: none;
  }

  .scan-line {
    display: none;
  }

  .neon-glow {
    box-shadow: none;
  }

  @keyframes glitch {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(60px, 60px);
    }
  }

  @keyframes scan {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100vh);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Forzar scroll vertical en la página de testimonios */
  body,
  html {
    overflow-y: auto !important;
    height: auto !important;
  }
</style>
