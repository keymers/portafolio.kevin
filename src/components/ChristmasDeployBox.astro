---
// 🎁 Caja Deploy 98+ Navideña - Peko's
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`christmas-deploy-promo ${className}`}>
  <div class="promo-card">
    <div class="promo-interactive-box">
      <div class="box-hint">
        <span class="hint-pulse"></span>
        <span>Haz hover para abrir tu regalo</span>
      </div>
      <svg viewBox="0 0 400 400" class="deploy-box-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Caja de regalo interactiva con despliegue de web 98+ Lighthouse">
        <style>
          .deploy-box-float { transform-origin: 200px 310px; animation: boxIdle 3.4s ease-in-out infinite; }
          .deploy-lid { transform-origin: 200px 190px; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
          .deploy-beam { opacity: 0; transform: scaleY(0.2); transform-origin: 200px 210px; transition: all 0.4s ease-out; }
          .deploy-rocket-card { opacity: 0; transform: translateY(30px) scale(0.75); transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s; }
          svg:hover .deploy-lid { transform: translateY(-38px) rotate(-11deg); }
          svg:hover .deploy-beam { opacity: 0.85; transform: scaleY(1); }
          svg:hover .deploy-rocket-card { opacity: 1; transform: translateY(-22px) scale(1); }
          @keyframes boxIdle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
        </style>
        <defs>
          <linearGradient id="boxDarkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e293b"></stop>
            <stop offset="100%" stop-color="#0f172a"></stop>
          </linearGradient>
          <linearGradient id="neonRibbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#4f46e5"></stop>
            <stop offset="50%" stop-color="#ec4899"></stop>
            <stop offset="100%" stop-color="#06b6d4"></stop>
          </linearGradient>
          <linearGradient id="beamGrad" x1="0%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.6"></stop>
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <ellipse cx="200" cy="355" rx="95" ry="11" fill="#000000" opacity="0.4"></ellipse>

        <!-- Haz de luz volumétrica al abrir la caja -->
        <polygon points="145,205 255,205 295,65 105,65" fill="url(#beamGrad)" class="deploy-beam"></polygon>

        <!-- Cohete y Tarjeta 98+ Lighthouse que emerge en Hover -->
        <g class="deploy-rocket-card" transform="translate(115, 78)">
          <rect x="0" y="0" width="170" height="76" rx="16" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5"></rect>
          <circle cx="34" cy="38" r="20" fill="#10b981" fill-opacity="0.15" stroke="#10b981" stroke-width="2"></circle>
          <text x="34" y="43" font-family="'JetBrains Mono', monospace" font-weight="800" font-size="13" fill="#34d399" text-anchor="middle">98+</text>
          
          <text x="108" y="33" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13" fill="#ffffff" text-anchor="middle">WEB LISTA 🚀</text>
          <text x="108" y="51" font-family="'JetBrains Mono', monospace" font-weight="600" font-size="10" fill="#38bdf8" text-anchor="middle">SEO + VELOCIDAD</text>
        </g>

        <!-- Caja Principal -->
        <g class="deploy-box-float">
          <!-- Cuerpo de la caja -->
          <rect x="130" y="205" width="140" height="135" rx="16" fill="url(#boxDarkGrad)" stroke="#334155" stroke-width="3"></rect>
          
          <!-- Cinta vertical neón -->
          <rect x="186" y="205" width="28" height="135" fill="url(#neonRibbonGrad)"></rect>
          <!-- Cinta horizontal neón -->
          <rect x="130" y="258" width="140" height="26" fill="url(#neonRibbonGrad)"></rect>

          <!-- Tapa de la caja (Se levanta al hacer hover) -->
          <g class="deploy-lid">
            <rect x="120" y="178" width="160" height="34" rx="10" fill="#1e293b" stroke="#475569" stroke-width="3"></rect>
            <rect x="184" y="178" width="32" height="34" fill="url(#neonRibbonGrad)"></rect>
            
            <!-- Moño futurista -->
            <path d="M192 178 C148 140, 138 112, 168 122 C192 130, 195 165, 195 178 Z" fill="#4f46e5" stroke="#818cf8" stroke-width="2"></path>
            <path d="M208 178 C252 140, 262 112, 232 122 C208 130, 205 165, 205 178 Z" fill="#06b6d4" stroke="#67e8f9" stroke-width="2"></path>
            <circle cx="200" cy="176" r="11" fill="#ec4899"></circle>
          </g>
        </g>
      </svg>
    </div>

    <div class="promo-info">
      <div class="promo-tag">
        <span>🎄 Promoción Especial de Navidad</span>
      </div>
      <h3 class="promo-title">
        Tu Sitio Web Listo y Desplegado con <span class="text-gradient">98+ en Lighthouse</span>
      </h3>
      <p class="promo-desc">
        Aprovecha la temporada navideña para transformar tu presencia digital. Construimos tu plataforma web o tienda con arquitectura moderna, carga instantánea y optimización SEO integral para vender más.
      </p>
      <div class="promo-features">
        <div class="p-feature">
          <span class="f-icon">⚡</span>
          <span>Velocidad extrema garantizada</span>
        </div>
        <div class="p-feature">
          <span class="f-icon">📱</span>
          <span>100% Adaptado a móviles</span>
        </div>
        <div class="p-feature">
          <span class="f-icon">🔍</span>
          <span>SEO técnico para Google Chile</span>
        </div>
      </div>
      <div class="promo-actions">
        <a
          href="https://wa.me/+56973650208?text=Hola!%20Vi%20la%20Caja%20Deploy%20de%20Navidad%20y%20quiero%20cotizar%20mi%20web"
          target="_blank"
          rel="noopener noreferrer"
          class="promo-btn-cta"
        >
          <span>🎁 Cotizar Gratis con Promo</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .christmas-deploy-promo {
    width: 100%;
    margin: 3.5rem 0 1rem;
    position: relative;
    z-index: 5;
  }

  .promo-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.7) 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 24px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2.5rem;
    align-items: center;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(56, 189, 248, 0.1);
    backdrop-filter: blur(16px);
    position: relative;
    overflow: hidden;
  }

  .promo-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(244, 63, 94, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .promo-interactive-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
  }

  .box-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: #38bdf8;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .hint-pulse {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: pulseHint 1.5s infinite;
  }

  @keyframes pulseHint {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .deploy-box-svg {
    width: 100%;
    max-width: 320px;
    height: auto;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.5));
    transition: transform 0.3s ease;
  }

  .deploy-box-svg:hover {
    transform: scale(1.03);
  }

  .promo-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .promo-tag {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(245, 158, 11, 0.2));
    border: 1px solid rgba(239, 68, 68, 0.4);
    font-size: 0.8rem;
    font-weight: 700;
    color: #fca5a5;
    letter-spacing: 0.03em;
  }

  .promo-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.25;
    color: #ffffff;
  }

  .text-gradient {
    background: linear-gradient(135deg, #38bdf8 0%, #34d399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .promo-desc {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
  }

  .promo-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.5rem 0;
  }

  .p-feature {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #e2e8f0;
  }

  .f-icon {
    font-size: 1rem;
  }

  .promo-actions {
    margin-top: 0.5rem;
  }

  .promo-btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.6rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(239, 68, 68, 0.4);
    transition: all 0.25s ease;
  }

  .promo-btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.6);
    background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
  }

  @media (max-width: 900px) {
    .promo-card {
      grid-template-columns: 1fr;
      padding: 1.75rem;
      gap: 1.5rem;
      text-align: center;
    }

    .promo-tag {
      align-self: center;
    }

    .promo-features {
      justify-content: center;
    }

    .promo-actions {
      display: flex;
      justify-content: center;
    }

    .promo-title {
      font-size: 1.5rem;
    }
  }
</style>

