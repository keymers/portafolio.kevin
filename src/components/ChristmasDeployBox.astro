---
// 🎁 Despliegue 98+ Lighthouse - Peko's
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`deploy-box-feature ${className}`}>
  <div class="deploy-card">
    <div class="deploy-visual" aria-hidden="true">
      <svg
        viewBox="0 0 400 420"
        class="deploy-box-svg"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Caja de despliegue interactiva 98+ Lighthouse"
      >
        <style>
          .deploy-box-float { transform-origin: 200px 320px; animation: boxIdle 3.6s ease-in-out infinite; }
          .deploy-lid { transform-origin: 200px 190px; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
          .deploy-beam { opacity: 0; transform: scaleY(0.2); transform-origin: 200px 210px; transition: all 0.4s ease-out; }
          .deploy-rocket-card { opacity: 0; transform: translateY(30px) scale(0.75); transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s; }
          .deploy-card:hover .deploy-lid, svg:hover .deploy-lid { transform: translateY(-40px) rotate(-11deg); }
          .deploy-card:hover .deploy-beam, svg:hover .deploy-beam { opacity: 0.85; transform: scaleY(1); }
          .deploy-card:hover .deploy-rocket-card, svg:hover .deploy-rocket-card { opacity: 1; transform: translateY(-26px) scale(1); }
          @keyframes boxIdle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
        </style>
        <defs>
          <linearGradient id="boxDarkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e293b"></stop>
            <stop offset="100%" stop-color="#0f172a"></stop>
          </linearGradient>
          <linearGradient id="neonRibbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#4f46e5"></stop>
            <stop offset="50%" stop-color="#ec4899"></stop>
            <stop offset="100%" stop-color="#06b6d4"></stop>
          </linearGradient>
          <linearGradient id="beamGrad" x1="0%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.65"></stop>
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.0"></stop>
          </linearGradient>
        </defs>

        <!-- Sombra base -->
        <ellipse cx="200" cy="370" rx="95" ry="11" fill="#000000" opacity="0.45"></ellipse>

        <!-- Haz de luz volumétrica al abrir la caja -->
        <polygon points="145,215 255,215 300,60 100,60" fill="url(#beamGrad)" class="deploy-beam"></polygon>

        <!-- Cohete y Tarjeta 98+ Lighthouse que emerge en Hover -->
        <g class="deploy-rocket-card" transform="translate(115, 82)">
          <rect x="0" y="0" width="170" height="76" rx="14" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5"></rect>
          <circle cx="34" cy="38" r="20" fill="#10b981" fill-opacity="0.15" stroke="#10b981" stroke-width="2"></circle>
          <text x="34" y="43" font-family="'JetBrains Mono', monospace" font-weight="800" font-size="13" fill="#34d399" text-anchor="middle">98+</text>
          
          <text x="108" y="33" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="12" fill="#ffffff" text-anchor="middle">WEB LISTA 🚀</text>
          <text x="108" y="51" font-family="'JetBrains Mono', monospace" font-weight="600" font-size="9.5" fill="#38bdf8" text-anchor="middle">SEO + VELOCIDAD</text>
        </g>

        <!-- Caja Principal -->
        <g class="deploy-box-float">
          <!-- Cuerpo de la caja -->
          <rect x="130" y="215" width="140" height="135" rx="16" fill="url(#boxDarkGrad)" stroke="#334155" stroke-width="2.5"></rect>
          
          <!-- Cinta vertical neón -->
          <rect x="186" y="215" width="28" height="135" fill="url(#neonRibbonGrad)"></rect>
          <!-- Cinta horizontal neón -->
          <rect x="130" y="268" width="140" height="26" fill="url(#neonRibbonGrad)"></rect>

          <!-- Tapa de la caja (Se levanta al hacer hover) -->
          <g class="deploy-lid">
            <rect x="120" y="188" width="160" height="34" rx="10" fill="#1e293b" stroke="#475569" stroke-width="2.5"></rect>
            <rect x="184" y="188" width="32" height="34" fill="url(#neonRibbonGrad)"></rect>
            
            <!-- Moño futurista -->
            <path d="M192 188 C148 150, 138 122, 168 132 C192 140, 195 175, 195 188 Z" fill="#4f46e5" stroke="#818cf8" stroke-width="2"></path>
            <path d="M208 188 C252 150, 262 122, 232 132 C208 140, 205 175, 205 188 Z" fill="#06b6d4" stroke="#67e8f9" stroke-width="2"></path>
            <circle cx="200" cy="186" r="10" fill="#ec4899"></circle>
          </g>
        </g>
      </svg>
    </div>

    <div class="deploy-content">
      <div class="deploy-badge">
        <span class="badge-dot"></span>
        <span>Rendimiento y Despliegue Express</span>
      </div>

      <h3 class="deploy-title">
        Tu página web lista con <span class="highlight">98+ en Google Lighthouse</span>
      </h3>

      <p class="deploy-description">
        Desarrollamos cada proyecto con arquitectura moderna enfocada en conversión: tiempos de carga menores a un segundo, Core Web Vitals en verde y optimización SEO semántica para que tus clientes te encuentren primero en Chile.
      </p>

      <ul class="deploy-features">
        <li>Carga instantánea optimizada para móviles</li>
        <li>Estructura técnica para indexación rápida en Google</li>
        <li>Código limpio sin dependencias innecesarias</li>
      </ul>

      <div class="deploy-actions">
        <a
          href="https://wa.me/+56973650208?text=Hola!%20Me%20interesa%20cotizar%20un%20proyecto%20con%20m%C3%A1ximo%20rendimiento%20web"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"></path>
          </svg>
          Cotizar Proyecto Web
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .deploy-box-feature {
    width: 100%;
    margin-top: 3.5rem;
    position: relative;
    z-index: 5;
  }

  .deploy-card {
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 20px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: center;
    backdrop-filter: blur(12px);
    transition: all 0.4s ease;
    position: relative;
    overflow: visible;
  }

  .deploy-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #38bdf8, #8b5cf6, #ec4899);
    border-radius: 20px 20px 0 0;
    opacity: 0.6;
  }

  .deploy-card:hover {
    border-color: rgba(59, 130, 246, 0.45);
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.12);
    transform: translateY(-4px);
  }

  .deploy-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: visible;
    cursor: pointer;
  }

  .deploy-box-svg {
    width: 100%;
    max-width: 280px;
    height: auto;
    overflow: visible;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.4));
    transition: transform 0.3s ease;
  }

  .deploy-card:hover .deploy-box-svg {
    transform: scale(1.02);
  }

  .deploy-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .deploy-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 9999px;
    color: #38bdf8;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .deploy-badge .badge-dot {
    width: 6px;
    height: 6px;
    background: #38bdf8;
    border-radius: 50%;
    box-shadow: 0 0 8px #38bdf8;
  }

  .deploy-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary, #f1f5f9);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .highlight {
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .deploy-description {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .deploy-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .deploy-features li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted, #cbd5e1);
    font-size: 0.875rem;
  }

  .deploy-features li::before {
    content: '✓';
    color: #10b981;
    font-weight: 700;
  }

  .deploy-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .deploy-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2rem;
      text-align: center;
    }

    .deploy-content {
      align-items: center;
    }

    .deploy-features {
      align-items: flex-start;
      text-align: left;
    }

    .deploy-title {
      font-size: 1.35rem;
    }

    .deploy-box-svg {
      max-width: 230px;
    }
  }
</style>
