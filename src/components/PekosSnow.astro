---
// ❄️ Nieve Ambiental Peko's - Ultra ligera y fluida
---

<div class="pekos-snow-layer" aria-hidden="true">
  <style>
    .pekos-snow-layer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 50;
      overflow: hidden;
    }
    .pekos-flake {
      position: absolute;
      top: -12px;
      background: #ffffff;
      border-radius: 9999px;
      opacity: 0.75;
      box-shadow: 0 0 6px rgba(255, 255, 255, 0.6);
      animation: pekosSnowFall linear infinite;
    }
    @keyframes pekosSnowFall {
      0% { transform: translateY(-10px) translateX(0px); opacity: 0; }
      15% { opacity: 0.8; }
      85% { opacity: 0.8; }
      100% { transform: translateY(105vh) translateX(25px); opacity: 0; }
    }
  </style>
  <span class="pekos-flake" style="left: 5%; width: 4px; height: 4px; animation-duration: 8s; animation-delay: -1s;"></span>
  <span class="pekos-flake" style="left: 14%; width: 3px; height: 3px; animation-duration: 11s; animation-delay: -4s;"></span>
  <span class="pekos-flake" style="left: 23%; width: 5px; height: 5px; animation-duration: 7s; animation-delay: -2s;"></span>
  <span class="pekos-flake" style="left: 34%; width: 3px; height: 3px; animation-duration: 10s; animation-delay: -6s;"></span>
  <span class="pekos-flake" style="left: 45%; width: 4px; height: 4px; animation-duration: 9s; animation-delay: -3s;"></span>
  <span class="pekos-flake" style="left: 57%; width: 5px; height: 5px; animation-duration: 7.5s; animation-delay: -5s;"></span>
  <span class="pekos-flake" style="left: 68%; width: 3px; height: 3px; animation-duration: 12s; animation-delay: -1s;"></span>
  <span class="pekos-flake" style="left: 79%; width: 4px; height: 4px; animation-duration: 8.5s; animation-delay: -7s;"></span>
  <span class="pekos-flake" style="left: 88%; width: 5px; height: 5px; animation-duration: 9.5s; animation-delay: -2s;"></span>
  <span class="pekos-flake" style="left: 95%; width: 3px; height: 3px; animation-duration: 10.5s; animation-delay: -4s;"></span>
</div>

