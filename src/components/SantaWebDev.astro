---
// 🎅 Santa Web Dev - Peko's
interface Props {
  className?: string;
  maxWidth?: string;
}

const { className = "", maxWidth = "340px" } = Astro.props;
---

<div class={`santa-web-dev-wrapper ${className}`} style={`max-width: ${maxWidth};`}>
  <svg viewBox="0 0 400 400" class="santa-web-dev-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Santa Claus desarrollador web">
    <style>
      .dev-santa-body { transform-origin: 200px 360px; animation: devBreathe 3.2s ease-in-out infinite; }
      .dev-santa-head { transform-origin: 200px 190px; animation: devHeadNod 3.2s ease-in-out infinite; }
      .dev-pompon { transform-origin: 282px 104px; animation: devPomponSwing 2.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite; }
      .dev-hand-l { transform-origin: 155px 265px; animation: typeLeft 0.45s ease-in-out infinite alternate; }
      .dev-hand-r { transform-origin: 245px 265px; animation: typeRight 0.45s 0.22s ease-in-out infinite alternate; }
      .code-float-1 { animation: codeFloat 2.8s ease-in-out infinite; }
      .code-float-2 { animation: codeFloat 3.2s 0.9s ease-in-out infinite; }
      .code-float-3 { animation: codeFloat 2.6s 1.6s ease-in-out infinite; }
      .screen-glow { animation: screenPulse 2.5s ease-in-out infinite alternate; }
      .glasses-reflection-normal { transition: opacity 0.3s ease; }
      .glasses-reflection-deploy { opacity: 0; transition: opacity 0.3s ease; }
      .deploy-badge { opacity: 0; transform: translateY(12px) scale(0.8); transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
      svg:hover .glasses-reflection-normal { opacity: 0; }
      svg:hover .glasses-reflection-deploy { opacity: 1; }
      svg:hover .deploy-badge { opacity: 1; transform: translateY(-4px) scale(1); }
      svg:hover .dev-hand-l { animation: none; transform: translateY(-18px) rotate(-18deg); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
      svg:hover .dev-hand-r { animation: none; transform: translateY(-18px) rotate(18deg); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
      @keyframes devBreathe { 0%, 100% { transform: translateY(0px) scale(1, 1); } 50% { transform: translateY(-4px) scale(1.012, 0.992); } }
      @keyframes devHeadNod { 0%, 100% { transform: rotate(0deg) translateY(0); } 30% { transform: rotate(2.2deg) translateY(1.5px); } 70% { transform: rotate(-1.5deg) translateY(-1px); } }
      @keyframes devPomponSwing { 0%, 100% { transform: rotate(0deg); } 40% { transform: rotate(15deg) translateY(3px); } 75% { transform: rotate(-10deg) translateY(-2px); } }
      @keyframes typeLeft { from { transform: translateY(0px) rotate(0deg); } to { transform: translateY(-4px) rotate(-4deg); } }
      @keyframes typeRight { from { transform: translateY(0px) rotate(0deg); } to { transform: translateY(-4px) rotate(4deg); } }
      @keyframes codeFloat { 0%, 100% { transform: translateY(0px); opacity: 0.7; } 50% { transform: translateY(-9px); opacity: 1; } }
      @keyframes screenPulse { from { opacity: 0.35; } to { opacity: 0.7; } }
    </style>
    <defs>
      <linearGradient id="santaSuitGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ef4444"></stop>
        <stop offset="60%" stop-color="#dc2626"></stop>
        <stop offset="100%" stop-color="#991b1b"></stop>
      </linearGradient>
      <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#fed7aa"></stop>
        <stop offset="100%" stop-color="#fdba74"></stop>
      </linearGradient>
      <linearGradient id="laptopShell" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#334155"></stop>
        <stop offset="50%" stop-color="#1e293b"></stop>
        <stop offset="100%" stop-color="#0f172a"></stop>
      </linearGradient>
      <linearGradient id="screenGlowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="#818cf8" stop-opacity="0.0"></stop>
      </linearGradient>
      <linearGradient id="beardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#ffffff"></stop>
        <stop offset="80%" stop-color="#f1f5f9"></stop>
        <stop offset="100%" stop-color="#cbd5e1"></stop>
      </linearGradient>
      <filter id="neonCyan" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
        <feComposite in="SourceGraphic" in2="blur" operator="over"></feComposite>
      </filter>
    </defs>

    <!-- Sombra base -->
    <ellipse cx="200" cy="370" rx="125" ry="12" fill="#000000" opacity="0.4"></ellipse>

    <!-- Partículas de código flotando alrededor -->
    <g font-family="'JetBrains Mono', monospace" font-weight="700" font-size="13" fill="#38bdf8">
      <text x="72" y="135" class="code-float-1">&lt;/&gt;</text>
      <text x="305" y="120" class="code-float-2" fill="#a855f7">&#123; &#125;</text>
      <text x="85" y="210" class="code-float-3" fill="#34d399">99%</text>
    </g>

    <!-- Cartel flotante de Deploy al hacer Hover -->
    <g class="deploy-badge" transform="translate(135, 22)">
      <rect x="0" y="0" width="130" height="32" rx="16" fill="#0f172a" stroke="#10b981" stroke-width="2"></rect>
      <circle cx="18" cy="16" r="5" fill="#10b981"></circle>
      <text x="72" y="20" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="11" fill="#34d399" text-anchor="middle">DEPLOY OK ✓</text>
    </g>

    <!-- Cuerpo y Torso -->
    <g class="dev-santa-body">
      <!-- Torso / Suéter Navideño Tech -->
      <path d="M115 245 C115 205, 285 205, 285 245 L295 335 H105 Z" fill="url(#santaSuitGrad)"></path>
      <!-- Sombra lateral izquierda para volumen 3D -->
      <path d="M115 245 C115 215, 155 208, 165 208 L150 335 H105 Z" fill="#7f1d1d" opacity="0.28"></path>
      <!-- Patrón geométrico navideño en el suéter -->
      <path d="M122 255 L135 245 L148 255 L161 245 L174 255 M226 255 L239 245 L252 255 L265 245 L278 255" stroke="#fde047" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.75"></path>

      <!-- Cabeza y Gorro -->
      <g class="dev-santa-head">
        <!-- Cuello de peluche blanco -->
        <rect x="145" y="196" width="110" height="22" rx="11" fill="#f8fafc"></rect>
        
        <!-- Orejas -->
        <circle cx="148" cy="152" r="11" fill="#fdba74"></circle>
        <circle cx="252" cy="152" r="11" fill="#fdba74"></circle>

        <!-- Rostro con sombreado -->
        <circle cx="200" cy="150" r="50" fill="url(#skinGrad)"></circle>
        <!-- Mejillas cálidas -->
        <ellipse cx="168" cy="160" rx="9" ry="6" fill="#fb7185" opacity="0.4"></ellipse>
        <ellipse cx="232" cy="160" rx="9" ry="6" fill="#fb7185" opacity="0.4"></ellipse>

        <!-- Barba esculpida con capas de profundidad -->
        <path d="M150 154 C138 178, 144 222, 168 242 C185 256, 215 256, 232 242 C256 222, 262 178, 250 154 C240 168, 226 176, 200 176 C174 176, 160 168, 150 154 Z" fill="url(#beardGrad)"></path>
        <!-- Contorno de sombra interna en barba -->
        <path d="M168 228 C184 242, 216 242, 232 228 C216 234, 184 234, 168 228 Z" fill="#cbd5e1" opacity="0.7"></path>

        <!-- Bigote estilizado -->
        <path d="M200 166 C186 158, 162 162, 154 175 C168 184, 188 180, 200 171 Z" fill="#ffffff"></path>
        <path d="M200 166 C214 158, 238 162, 246 175 C232 184, 212 180, 200 171 Z" fill="#ffffff"></path>

        <!-- Nariz -->
        <ellipse cx="200" cy="157" rx="9" ry="7" fill="#f87171"></ellipse>
        <ellipse cx="197" cy="155" rx="3" ry="1.8" fill="#ffffff" opacity="0.7"></ellipse>

        <!-- Gafas Modernas Tech (Con reflejo de código) -->
        <g transform="translate(0, -2)">
          <!-- Marco oscuro estilizado -->
          <rect x="160" y="134" width="34" height="22" rx="6" fill="#0f172a" stroke="#38bdf8" stroke-width="2"></rect>
          <rect x="206" y="134" width="34" height="22" rx="6" fill="#0f172a" stroke="#38bdf8" stroke-width="2"></rect>
          <line x1="194" y1="143" x2="206" y2="143" stroke="#38bdf8" stroke-width="2.5"></line>
          
          <!-- Reflejo normal (Líneas de código cian) -->
          <g class="glasses-reflection-normal">
            <line x1="166" y1="141" x2="182" y2="141" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"></line>
            <line x1="166" y1="147" x2="176" y2="147" stroke="#818cf8" stroke-width="2" stroke-linecap="round"></line>
            <line x1="212" y1="141" x2="228" y2="141" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"></line>
            <line x1="212" y1="147" x2="222" y2="147" stroke="#818cf8" stroke-width="2" stroke-linecap="round"></line>
          </g>

          <!-- Reflejo Hover (Checks verdes de compilación) -->
          <g class="glasses-reflection-deploy">
            <path d="M170 145 L175 150 L184 139" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
            <path d="M216 145 L221 150 L230 139" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </g>
        </g>

        <!-- Cejas blancas -->
        <path d="M163 125 Q177 120 190 125" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none"></path>
        <path d="M210 125 Q223 120 237 125" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none"></path>

        <!-- Gorro Navideño con caída natural -->
        <path d="M148 122 C152 68, 224 58, 254 84 C272 98, 282 114, 284 124 C270 112, 255 106, 240 112 Z" fill="#b91c1c"></path>
        <path d="M148 122 C150 74, 246 74, 248 122 Z" fill="url(#santaSuitGrad)"></path>
        <rect x="140" y="110" width="120" height="20" rx="10" fill="#f8fafc"></rect>
        <!-- Pompón oscilante -->
        <g class="dev-pompon">
          <circle cx="286" cy="128" r="14" fill="#ffffff"></circle>
          <circle cx="282" cy="124" r="5" fill="#e2e8f0" opacity="0.7"></circle>
        </g>
      </g>
    </g>

    <!-- Haz de luz proyectado desde la pantalla hacia Santa -->
    <polygon points="125,245 275,245 250,150 150,150" fill="url(#screenGlowGrad)" class="screen-glow" pointer-events="none"></polygon>

    <!-- Manos / Manoplas tecleando o celebrando -->
    <g class="dev-hand-l">
      <rect x="128" y="255" width="30" height="22" rx="11" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"></rect>
    </g>
    <g class="dev-hand-r">
      <rect x="242" y="255" width="30" height="22" rx="11" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"></rect>
    </g>

    <!-- Laptop (Vista trasera con Logo Peko's iluminado) -->
    <g transform="translate(115, 245)">
      <!-- Base escritorio sutil -->
      <rect x="-25" y="108" width="220" height="6" rx="3" fill="#334155"></rect>
      <!-- Carcasa de pantalla -->
      <rect x="0" y="0" width="170" height="104" rx="12" fill="url(#laptopShell)" stroke="#475569" stroke-width="2.5"></rect>
      <!-- Bisel inferior -->
      <rect x="-8" y="102" width="186" height="7" rx="3.5" fill="#64748b"></rect>
      
      <!-- Emblema Peko's Luminoso en el centro de la laptop -->
      <g transform="translate(85, 50)" filter="url(#neonCyan)">
        <polygon points="0,-18 16,-9 16,9 0,18 -16,9 -16,-9" fill="#0f172a" stroke="#38bdf8" stroke-width="2"></polygon>
        <text x="0" y="4" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="11" fill="#f8fafc" text-anchor="middle">P'S</text>
      </g>
      <text x="85" y="82" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="10" fill="#94a3b8" text-anchor="middle" letter-spacing="2">PEKO'S</text>
    </g>
  </svg>
</div>

<style>
  .santa-web-dev-wrapper {
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    position: relative;
    cursor: pointer;
  }

  .santa-web-dev-svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.45));
    transition: transform 0.3s ease;
  }

  .santa-web-dev-wrapper:hover .santa-web-dev-svg {
    transform: translateY(-4px);
  }
</style>
