---
// ✨ Emblema Peko's Luminoso - Peko's
interface Props {
  className?: string;
  withText?: boolean;
}

const { className = "", withText = true } = Astro.props;
---

<div class={`pekos-emblem-wrapper ${className}`}>
  <svg
    viewBox="0 0 170 100"
    class="pekos-emblem-svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Emblema luminoso Peko's"
  >
    <defs>
      <filter id="neonCyanEmblem" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
        <feComposite in="SourceGraphic" in2="blur" operator="over"></feComposite>
      </filter>
    </defs>

    <!-- Emblema Peko's Luminoso -->
    <g transform="translate(85, 42)" filter="url(#neonCyanEmblem)" class="emblem-group">
      <polygon points="0,-22 20,-11 20,11 0,22 -20,11 -20,-11" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5"></polygon>
      <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13" fill="#f8fafc" text-anchor="middle">P'S</text>
    </g>
    
    {withText && (
      <text x="85" y="80" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="11" fill="#94a3b8" text-anchor="middle" letter-spacing="2" class="emblem-text">PEKO'S</text>
    )}
  </svg>
</div>

<style>
  .pekos-emblem-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .pekos-emblem-wrapper:hover {
    transform: scale(1.08);
  }

  .pekos-emblem-svg {
    width: 100%;
    max-width: 130px;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.4));
  }

  .emblem-group {
    animation: emblemPulse 3s ease-in-out infinite alternate;
  }

  @keyframes emblemPulse {
    from { filter: drop-shadow(0 0 4px #38bdf8); }
    to { filter: drop-shadow(0 0 12px #38bdf8); }
  }
</style>

