---
// 🎁 Caja de Regalo Navideña Interactiva - Peko's
interface Props {
  className?: string;
  maxWidth?: string;
}

const { className = "", maxWidth = "160px" } = Astro.props;
---

<div class={`christmas-gift-box-wrapper ${className}`} style={`max-width: ${maxWidth};`}>
  <svg
    viewBox="0 0 400 420"
    class="gift-box-svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Caja de regalo navideña interactiva"
  >
    <style>
      .gift-box-float { transform-origin: 200px 320px; animation: boxIdle 3.6s ease-in-out infinite; }
      .gift-lid { transform-origin: 200px 190px; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
      .gift-beam { opacity: 0; transform: scaleY(0.2); transform-origin: 200px 210px; transition: all 0.4s ease-out; }
      .gift-card { opacity: 0; transform: translateY(30px) scale(0.75); transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s; }
      svg:hover .gift-lid { transform: translateY(-40px) rotate(-11deg); }
      svg:hover .gift-beam { opacity: 0.85; transform: scaleY(1); }
      svg:hover .gift-card { opacity: 1; transform: translateY(-24px) scale(1); }
      @keyframes boxIdle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
    </style>
    <defs>
      <linearGradient id="boxDarkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e293b"></stop>
        <stop offset="100%" stop-color="#0f172a"></stop>
      </linearGradient>
      <linearGradient id="neonRibbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#4f46e5"></stop>
        <stop offset="50%" stop-color="#ec4899"></stop>
        <stop offset="100%" stop-color="#06b6d4"></stop>
      </linearGradient>
      <linearGradient id="beamGrad" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.65"></stop>
        <stop offset="100%" stop-color="#818cf8" stop-opacity="0.0"></stop>
      </linearGradient>
    </defs>

    <!-- Sombra base -->
    <ellipse cx="200" cy="370" rx="95" ry="11" fill="#000000" opacity="0.45"></ellipse>

    <!-- Haz de luz volumétrica al abrir la caja -->
    <polygon points="145,215 255,215 300,60 100,60" fill="url(#beamGrad)" class="gift-beam"></polygon>

    <!-- Tarjeta Navideña sorpresa que emerge en Hover -->
    <g class="gift-card" transform="translate(115, 82)">
      <rect x="0" y="0" width="170" height="74" rx="14" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5"></rect>
      <circle cx="34" cy="37" r="18" fill="#ef4444" fill-opacity="0.2" stroke="#ef4444" stroke-width="2"></circle>
      <text x="34" y="43" font-size="16" text-anchor="middle">🎁</text>
      
      <text x="108" y="32" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="12" fill="#ffffff" text-anchor="middle">¡FELIZ NAVIDAD! 🎄</text>
      <text x="108" y="50" font-family="'JetBrains Mono', monospace" font-weight="600" font-size="10" fill="#38bdf8" text-anchor="middle">PEKO'S STUDIO ✨</text>
    </g>

    <!-- Caja Principal -->
    <g class="gift-box-float">
      <!-- Cuerpo de la caja -->
      <rect x="130" y="215" width="140" height="135" rx="16" fill="url(#boxDarkGrad)" stroke="#334155" stroke-width="2.5"></rect>
      
      <!-- Cinta vertical neón -->
      <rect x="186" y="215" width="28" height="135" fill="url(#neonRibbonGrad)"></rect>
      <!-- Cinta horizontal neón -->
      <rect x="130" y="268" width="140" height="26" fill="url(#neonRibbonGrad)"></rect>

      <!-- Tapa de la caja (Se levanta al hacer hover) -->
      <g class="gift-lid">
        <rect x="120" y="188" width="160" height="34" rx="10" fill="#1e293b" stroke="#475569" stroke-width="2.5"></rect>
        <rect x="184" y="188" width="32" height="34" fill="url(#neonRibbonGrad)"></rect>
        
        <!-- Moño futurista -->
        <path d="M192 188 C148 150, 138 122, 168 132 C192 140, 195 175, 195 188 Z" fill="#4f46e5" stroke="#818cf8" stroke-width="2"></path>
        <path d="M208 188 C252 150, 262 122, 232 132 C208 140, 205 175, 205 188 Z" fill="#06b6d4" stroke="#67e8f9" stroke-width="2"></path>
        <circle cx="200" cy="186" r="10" fill="#ec4899"></circle>
      </g>
    </g>
  </svg>
</div>

<style>
  .christmas-gift-box-wrapper {
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    position: relative;
    cursor: pointer;
    overflow: visible;
  }

  .gift-box-svg {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.4));
    transition: transform 0.3s ease;
  }

  .christmas-gift-box-wrapper:hover .gift-box-svg {
    transform: scale(1.05);
  }
</style>
