---
// 🎁 Caja de Regalo Navideña Interactiva - Peko's
interface Props {
  className?: string;
  maxWidth?: string;
}

const { className = "", maxWidth = "310px" } = Astro.props;
---

<div class={`christmas-gift-box-wrapper ${className}`} style={`max-width: ${maxWidth};`}>
  <svg
    viewBox="0 0 400 390"
    class="gift-box-svg"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Caja de regalo navideña interactiva"
  >
    <style>
      .gift-wrapper-group {
        transform-origin: 200px 320px;
        animation: boxFloat 3.6s ease-in-out infinite;
      }

      .gift-lid-group {
        transform-origin: 120px 210px;
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .gift-beam {
        opacity: 0;
        transform: scaleY(0.2);
        transform-origin: 200px 220px;
        transition: all 0.45s ease-out;
      }

      .gift-card-group {
        opacity: 0;
        transform: translateY(0px) scale(0.65);
        transform-origin: 200px 100px;
        transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s;
        pointer-events: none;
      }

      /* Efecto al hacer hover */
      svg:hover .gift-lid-group,
      .christmas-gift-box-wrapper:hover .gift-lid-group {
        transform: translate(-35px, -55px) rotate(-22deg);
      }

      svg:hover .gift-beam,
      .christmas-gift-box-wrapper:hover .gift-beam {
        opacity: 0.9;
        transform: scaleY(1);
      }

      svg:hover .gift-card-group,
      .christmas-gift-box-wrapper:hover .gift-card-group {
        opacity: 1;
        transform: translateY(-135px) scale(1);
      }

      @keyframes boxFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-7px); }
      }
    </style>

    <defs>
      <!-- Gradiente caja oscura tech -->
      <linearGradient id="boxBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1e293b"></stop>
        <stop offset="60%" stop-color="#0f172a"></stop>
        <stop offset="100%" stop-color="#090d16"></stop>
      </linearGradient>

      <!-- Cinta neón navideña -->
      <linearGradient id="neonRibbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#ef4444"></stop>
        <stop offset="50%" stop-color="#ec4899"></stop>
        <stop offset="100%" stop-color="#38bdf8"></stop>
      </linearGradient>

      <!-- Haz de luz mágica -->
      <linearGradient id="magicBeamGrad" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8"></stop>
        <stop offset="50%" stop-color="#818cf8" stop-opacity="0.4"></stop>
        <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"></stop>
      </linearGradient>

      <!-- Filtro resplandor tarjeta -->
      <filter id="cardNeonGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur>
        <feComposite in="SourceGraphic" in2="blur" operator="over"></feComposite>
      </filter>
    </defs>

    <!-- Sombra base elíptica suave -->
    <ellipse cx="200" cy="355" rx="105" ry="13" fill="#000000" opacity="0.5"></ellipse>

    <g class="gift-wrapper-group">
      <!-- Haz de luz volumétrica (emerge del interior de la caja) -->
      <polygon points="140,225 260,225 325,30 75,30" fill="url(#magicBeamGrad)" class="gift-beam"></polygon>

      <!-- Caja Principal (Ancha y proporcionada, NO alargada) -->
      <g class="gift-box-body">
        <!-- Cuerpo de la caja: 170 ancho x 115 alto -->
        <rect x="115" y="225" width="170" height="115" rx="16" fill="url(#boxBodyGrad)" stroke="#334155" stroke-width="2.5"></rect>
        
        <!-- Cinta vertical neón -->
        <rect x="186" y="225" width="28" height="115" fill="url(#neonRibbonGrad)"></rect>
        <!-- Cinta horizontal neón -->
        <rect x="115" y="268" width="170" height="26" fill="url(#neonRibbonGrad)"></rect>
      </g>

      <!-- Tapa de la caja con Moño (Se levanta hacia la izquierda al hacer hover) -->
      <g class="gift-lid-group">
        <!-- Tapa: 190 ancho x 30 alto -->
        <rect x="105" y="198" width="190" height="30" rx="9" fill="#1e293b" stroke="#475569" stroke-width="2.5"></rect>
        <rect x="184" y="198" width="32" height="30" fill="url(#neonRibbonGrad)"></rect>
        
        <!-- Moño decorativo -->
        <path d="M192 198 C150 160, 138 132, 168 142 C192 150, 195 185, 195 198 Z" fill="#ef4444" stroke="#f87171" stroke-width="2"></path>
        <path d="M208 198 C250 160, 262 132, 232 142 C208 150, 205 185, 205 198 Z" fill="#38bdf8" stroke="#7dd3fc" stroke-width="2"></path>
        <circle cx="200" cy="196" r="10" fill="#ec4899" stroke="#f472b6" stroke-width="1.5"></circle>
      </g>

      <!-- Tarjeta Navideña (Renderizada AL FINAL para estar 100% AL FRENTE y visible) -->
      <g class="gift-card-group" transform="translate(0, 210)" filter="url(#cardNeonGlow)">
        <!-- Fondo de la tarjeta -->
        <rect x="90" y="0" width="220" height="76" rx="16" fill="#0b1120" stroke="#38bdf8" stroke-width="2.5"></rect>
        
        <!-- Ícono regalo -->
        <circle cx="128" cy="38" r="19" fill="rgba(239, 68, 68, 0.25)" stroke="#ef4444" stroke-width="2"></circle>
        <text x="128" y="45" font-size="18" text-anchor="middle">🎁</text>
        
        <!-- Texto claro y legible -->
        <text x="215" y="33" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13.5" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">¡FELIZ NAVIDAD! 🎄</text>
        <text x="215" y="53" font-family="'JetBrains Mono', monospace" font-weight="700" font-size="11" fill="#38bdf8" text-anchor="middle" letter-spacing="1.5">PEKO'S STUDIO ✨</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .christmas-gift-box-wrapper {
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    cursor: pointer;
    overflow: visible;
  }

  .gift-box-svg {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
    filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.45));
    transition: transform 0.3s ease;
  }

  .christmas-gift-box-wrapper:hover .gift-box-svg {
    transform: scale(1.04);
  }
</style>
